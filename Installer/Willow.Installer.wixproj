<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>WillowSetup-x64</OutputName>
    <Platform>x64</Platform>
    <!-- Default publish path; override with /p:PublishDir=... on the command line -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\Willow\bin\Release\net8.0-windows10.0.19041.0\win-x64\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />
  </ItemGroup>

  <!-- Harvest all published files into the ApplicationFiles component group -->
  <ItemGroup>
    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>ApplicationFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>

  <!-- Stale Rewind.* files left in the publish dir by old builds before the rename -->
  <ItemGroup>
    <StaleRewindFiles Include="$(PublishDir)Rewind.*" />
  </ItemGroup>

  <!-- Delete stale Rewind.* files before harvesting so they don't end up in the MSI -->
  <Target Name="RemoveStaleRewindArtifacts" BeforeTargets="HarvestDirectory">
    <Delete Files="@(StaleRewindFiles)" />
    <Message Text="Removed stale Rewind artifacts: @(StaleRewindFiles)" Importance="normal" />
  </Target>

  <!-- Make the publish directory a bind path so WiX can resolve Willow.exe for the icon -->
  <ItemGroup>
    <BindPath Include="$(PublishDir)" />
  </ItemGroup>

</Project>

<Page
    x:Class="Rewind.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="Налаштування" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8" MaxWidth="600" HorizontalAlignment="Left" />
            <TextBlock Text="Твіки" Style="{StaticResource SubheaderTextBlockStyle}" />
            <ToggleSwitch Header="Автоматичне створення точки відновлення системи" IsOn="{x:Bind ViewModel.EnableBackups, Mode=TwoWay}" OnContent="Увімкнено" OffContent="Вимкнено" />

        </StackPanel>
    </Grid>
</Page>

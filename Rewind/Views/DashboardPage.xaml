<Page
    x:Class="Rewind.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="24">

            <TextBlock x:Uid="DashboardPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="DashboardPage_ResourcesHeader" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.6" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <ProgressRing Width="80" Height="80"
                                      Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                      Maximum="100"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Uid="DashboardPage_CpuLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CpuSpeedText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <ProgressRing Width="80" Height="80"
                                      Value="{x:Bind ViewModel.RamUsage, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                      Maximum="100"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Uid="DashboardPage_RamLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RamSizeText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Disk C: -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,24">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <ProgressRing Width="80" Height="80"
                                      Value="{x:Bind ViewModel.DiskUsage, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                      Maximum="100"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Uid="DashboardPage_DiskLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.DiskUsageText, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.DiskSizeText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.FreeableText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                        <Button x:Uid="DashboardPage_CleanUpButton"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                Click="CleanUpButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

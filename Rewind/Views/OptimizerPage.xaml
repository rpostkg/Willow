<Page
    x:Class="Rewind.Views.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Rewind.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Твіки" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20"/>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Severity="Warning"
                 Title="Зверніть увагу: Точка відновлення системи"
                 Message="Хоча система відкату враховує ваші поточні ключі реєстру та має стандартні варіанти відновлення, шанс того, що глибокі налаштування можуть пошкодити ОС, ніколи не дорівнює нулю. Точка відновлення системи буде створена автоматично перед застосуванням будь-яких налаштувань. Це повідомлення буде показано лише один раз. Закриття цього повідомлення дозволить вам застосовувати налаштування."
                 Margin="0,0,0,20"
                 CloseButtonClick="InfoBar_CloseButtonClick" />
        
        <ScrollViewer Grid.Row="2">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tweaks}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinRowSpacing="12" MinColumnSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Tweak">
                        <StackPanel  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" Style="{StaticResource PivotTitleContentControlStyle}" Margin="0,0,0,0" Padding="8,3,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Category}" Foreground="Gray" Margin="0,4,0,0" FontSize="12"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,20,0,0" HorizontalAlignment="Right">
            <Button Content="Відкотити вибране" Click="RevertButton_Click" IsEnabled="{x:Bind ViewModel.CanReviewOrRevert, Mode=OneWay}" />
            <Button Content="Переглянути вибране" Style="{StaticResource AccentButtonStyle}" Click="ReviewButton_Click" IsEnabled="{x:Bind ViewModel.CanReviewOrRevert, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>

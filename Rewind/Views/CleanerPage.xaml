<Page
    x:Class="Rewind.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="20">
        <TextBlock x:Uid="CleanerPage_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="Gray" />

        <StackPanel Spacing="8">
            <TextBlock x:Uid="CleanerPage_TempFilesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="CleanerPage_UserTempLabel" VerticalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="{x:Bind ViewModel.UserTempSize, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="CleanerPage_WinTempLabel" VerticalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="{x:Bind ViewModel.WindowsTempSize, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="CleanerPage_TotalLabel" VerticalAlignment="Center" Foreground="Gray"/>
                <TextBlock Text="{x:Bind ViewModel.TempSize, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" />
                <Button x:Uid="CleanerPage_CleanButton" Command="{x:Bind ViewModel.CleanCommand}" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Page>

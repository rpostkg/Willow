<ContentDialog
    x:Class="Rewind.Views.ReviewChangesDialog"
    x:Uid="ReviewChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Rewind.Models"
    mc:Ignorable="d"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="400">
        <ItemsRepeater x:Name="ChangesRepeater">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:ChangeItem">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{x:Bind DisplayTarget}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ValuePanel" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="OldValueText" Text="{x:Bind DisplayOldValue}" Foreground="Gray" Visibility="{x:Bind IsRegistryOrServiceVisible, Mode=OneWay}" />
                            <TextBlock x:Name="ArrowText" Text="&#x2192;" Foreground="Gray" Visibility="{x:Bind IsRegistryOrServiceVisible, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind NewValue}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</ContentDialog>

<ContentDialog
    x:Class="Rewind.Views.ReviewChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Rewind.Models"
    mc:Ignorable="d"
    Title="Review Changes"
    PrimaryButtonText="Confirm &amp; Apply"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="400">
        <ItemsRepeater x:Name="ChangesRepeater">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:ChangeItem">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{x:Bind Target}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind OldValue}" Foreground="Gray" />
                            <TextBlock Text="&#x2192;" Foreground="Gray" />
                            <TextBlock Text="{x:Bind NewValue}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</ContentDialog>

<Page
    x:Class="Rewind.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Rewind.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Uid="StartupPage_Title"
                   Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.StartupItems}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupItem">
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16,12"
                                CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE72E;"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind AdminIconVisibility}"/>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Command}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind HiveLabel}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                             IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                             IsEnabled="{x:Bind CanToggle}"
                                             OnContent=""
                                             OffContent=""
                                             VerticalAlignment="Center"
                                             Margin="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>

<Page
    x:Class="Willow.Views.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Willow.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Title -->
            <RowDefinition Height="Auto"/>
            <!-- 1: InfoBar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Search + Category filter -->
            <RowDefinition Height="*"/>
            <!-- 3: Tweak list -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Action buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Uid="OptimizerPage_Title"
                   Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,20"/>

        <!-- Warning InfoBar -->
        <InfoBar x:Uid="OptimizerPage_InfoBar"
                 Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Severity="Warning"
                 Margin="0,0,0,16"
                 CloseButtonClick="InfoBar_CloseButtonClick" />

        <!-- Search bar + Category ComboBox -->
        <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Name search fills remaining space -->
                <ColumnDefinition Width="200"/>
                <!-- Category picker fixed width -->
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Uid="OptimizerPage_SearchBox"
                            Grid.Column="0"
                            x:Name="TweakSearchBox"
                            QueryIcon="Find"
                            TextChanged="TweakSearchBox_TextChanged"
                            VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.Categories}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"/>
        </Grid>

        <!-- Tweak cards -->
        <ScrollViewer Grid.Row="3">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredTweaks, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinRowSpacing="12" MinColumnSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Tweak">
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="8"
                                MinHeight="200"
                                CornerRadius="8">
                            <StackPanel>
                                <Border Background="Green"
                                        CornerRadius="4" Padding="6,2" Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind AppliedBadgeVisibility, Mode=OneWay}">
                                    <TextBlock x:Uid="OptimizerPage_AppliedBadge" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <CheckBox HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Content="{x:Bind Name}"
                                    IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                    Style="{StaticResource PivotTitleContentControlStyle}"
                                    Padding="8,3,0,0"
                                    VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="6,2" 
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind Category}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           Margin="0,0,0,0"
                                           FontSize="12"/>
                                </Border>
                                <TextBlock Text="{x:Bind Description}"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,8,0,0"
                                           ToolTipService.ToolTip="{x:Bind Description}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button x:Uid="OptimizerPage_RevertButton"
                    Click="RevertButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanReviewOrRevert, Mode=OneWay}" />
            <Button x:Uid="OptimizerPage_ReviewButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ReviewButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanReviewOrRevert, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>

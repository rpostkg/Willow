<Page
    x:Class="Willow.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Willow.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Uid="StartupPage_Title"
                   Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,20"/>

        <!-- Search + Source filter -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Uid="StartupPage_SearchBox"
                            x:Name="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.SourceFilters}"
                      SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"/>
        </Grid>

        <!-- Item list -->
        <ScrollViewer Grid.Row="2">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupItem">
                        <Border BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16,12"
                                CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <FontIcon x:Uid="StartupPage_AdminIcon"
                                                  Glyph="&#xEA18;"
                                                  FontSize="11"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind AdminIconVisibility}"/>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Command}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind HiveLabel}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        x:Uid="StartupPage_OpenLocationButton"
                                        Click="OpenLocationButton_Click"
                                        Tag="{x:Bind}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        VerticalAlignment="Center"
                                        Padding="8,6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14"/>
                                </Button>

                                <ToggleSwitch Grid.Column="2"
                                             IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                             IsEnabled="{x:Bind CanToggle}"
                                             OnContent=""
                                             OffContent=""
                                             VerticalAlignment="Center"
                                             Margin="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>

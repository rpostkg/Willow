<Page
    x:Class="Willow.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock x:Uid="SettingsPage_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage_LanguageHeader" Style="{StaticResource SubheaderTextBlockStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                          SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage_ThemeHeader" Style="{StaticResource SubheaderTextBlockStyle}" />
                <TextBlock x:Uid="SettingsPage_ThemeText" />
                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableThemes}"
                          SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage_StartupHeader" Style="{StaticResource SubheaderTextBlockStyle}" />
                <ToggleSwitch x:Uid="SettingsPage_ResolveShortcutsToggle"
                              IsOn="{x:Bind ViewModel.ResolveShortcuts, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage_CustomCleanerHeader" Style="{StaticResource SubheaderTextBlockStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.CustomCleanerPaths, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13"/>
                                <Button Grid.Column="1"
                                        Tag="{x:Bind}"
                                        Click="RemovePathButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="6,4"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button x:Uid="SettingsPage_AddCleanerPath"
                        Click="AddFolderButton_Click"
                        Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SettingsPage_TweaksHeader" Style="{StaticResource SubheaderTextBlockStyle}" />
                <ToggleSwitch x:Uid="SettingsPage_RestorePointToggle"
                              IsOn="{x:Bind ViewModel.EnableBackups, Mode=TwoWay}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
